root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{html,css,js,json,yaml,yml,toml,ini,cfg}]
indent_style = space
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
