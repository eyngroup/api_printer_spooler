# Normalize line endings across Windows, Linux and macOS
* text=auto eol=lf

# Source and config files
*.py     text eol=lf
*.pyi    text eol=lf
*.xml    text eol=lf
*.xsd    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.csv    text eol=lf
*.md     text eol=lf
*.rst    text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.bash   text eol=lf
*.svg    text eol=lf

# Windows scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.bz2    binary
*.xz     binary
*.odt    binary
*.ods    binary
*.odp    binary
*.xlsx   binary
*.xls    binary
*.docx   binary
*.pptx   binary
*.sqlite binary
*.sqlite3 binary
*.db     binary
*.dll    binary
*.so     binary
*.dylib  binary
*.exe    binary
