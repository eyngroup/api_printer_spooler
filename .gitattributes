# Normalize line endings across Windows, Linux and macOS
* text=auto eol=lf

# Source and config files
*.py     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.svg    text eol=lf

# Windows scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.png    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.db     binary
*.exe    binary
*.dll    binary
